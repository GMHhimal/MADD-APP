<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_screen_gradient"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingEnd="@dimen/screen_gutter">

    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:background="@drawable/brand_tile_gradient"
        android:elevation="14dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_note"
            android:tint="@color/text_on_brand"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Lumina.Text.H1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="XML Layout Demo" />

    <TextView
        android:id="@+id/tvDashboardMessage"
        style="@style/Lumina.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="This build uses the classic Android XML layout system on the same Room database as the Compose version." />

    <Button
        android:id="@+id/btnDashboardBack"
        style="@style/Lumina.Button.Primary"
        android:layout_width="220dp"
        android:layout_marginTop="26dp"
        android:text="Open Lumina" />
</LinearLayout>
