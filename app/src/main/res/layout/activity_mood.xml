<?xml version="1.0" encoding="utf-8"?>
<!-- Mood check-in — port of feature/mood/MoodScreen.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingTop="@dimen/screen_top_padding"
            android:paddingBottom="@dimen/screen_bottom_padding">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <ImageView
                    android:id="@+id/btnBack"
                    style="@style/Lumina.IconChip"
                    android:src="@drawable/ic_chevron_left"
                    android:background="@drawable/btn_circle"
                    android:tint="@color/text_primary"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Back" />

                <TextView
                    style="@style/Lumina.Text.H2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="How are you feeling?" />
            </LinearLayout>

            <TextView
                style="@style/Lumina.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="A quick check-in helps Lumina understand your day. There are no wrong answers." />

            <!-- Mood options. Selection is carried by fill, border weight and the
                 face itself, never by colour alone. -->
            <RadioGroup
                android:id="@+id/groupMood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp">

                <RadioButton
                    android:id="@+id/moodGreat"
                    style="@style/Lumina.Option"
                    android:drawableStart="@drawable/ic_mood_great"
                    android:drawableTint="@color/brand_mint_deep"
                    android:text="Great" />

                <RadioButton
                    android:id="@+id/moodGood"
                    style="@style/Lumina.Option"
                    android:checked="true"
                    android:drawableStart="@drawable/ic_mood_good"
                    android:drawableTint="@color/brand_primary_deep"
                    android:text="Good" />

                <RadioButton
                    android:id="@+id/moodOkay"
                    style="@style/Lumina.Option"
                    android:drawableStart="@drawable/ic_mood_okay"
                    android:drawableTint="@color/text_secondary"
                    android:text="Okay" />

                <RadioButton
                    android:id="@+id/moodLow"
                    style="@style/Lumina.Option"
                    android:drawableStart="@drawable/ic_mood_low"
                    android:drawableTint="@color/brand_lavender_deep"
                    android:text="Low" />

                <RadioButton
                    android:id="@+id/moodStressed"
                    style="@style/Lumina.Option"
                    android:drawableStart="@drawable/ic_mood_stressed"
                    android:drawableTint="@color/brand_peach_deep"
                    android:text="Stressed" />
            </RadioGroup>

            <TextView
                style="@style/Lumina.Text.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="What influenced it?" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <CheckBox
                    style="@style/Lumina.Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:checked="true"
                    android:drawableStart="@drawable/ic_book"
                    android:drawableTint="@color/brand_primary_deep"
                    android:text="Studies" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <CheckBox
                    style="@style/Lumina.Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_moon"
                    android:drawableTint="@color/text_secondary"
                    android:text="Sleep" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <CheckBox
                    style="@style/Lumina.Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_heart"
                    android:drawableTint="@color/text_secondary"
                    android:text="Health" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <CheckBox
                    style="@style/Lumina.Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_users"
                    android:drawableTint="@color/text_secondary"
                    android:text="People" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMoodSave"
                style="@style/Lumina.Button.Primary"
                android:layout_marginTop="26dp"
                android:text="Save Mood" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
