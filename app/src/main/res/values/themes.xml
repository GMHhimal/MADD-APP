<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Theme.Lumina drives both the Compose MainActivity and the XML
        XmlMainActivity. Tinting the framework control colours here is what
        makes stock RadioButton / CheckBox / Switch / ProgressBar pick up the
        brand blue instead of the default teal.
    -->
    <style name="Theme.Lumina" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:colorPrimary">@color/brand_primary</item>
        <item name="android:colorPrimaryDark">@color/brand_primary_deep</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:colorControlActivated">@color/brand_primary</item>
        <item name="android:colorControlNormal">@color/border_strong</item>
        <item name="android:colorControlHighlight">@color/ripple_on_light</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textColorLink">@color/brand_primary_deep</item>

        <item name="android:fontFamily">sans-serif</item>
        <item name="android:dialogTheme">@style/Theme.Lumina.Dialog</item>
    </style>

    <!--
        Dialog() picks up android:dialogTheme from the activity theme, so the
        add-habit / add-deadline / add-reminder sheets get a transparent window
        and let the layout's own 28dp rounded surface be the visible card.
    -->
    <style name="Theme.Lumina.Dialog" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:colorControlActivated">@color/brand_primary</item>
        <item name="android:colorControlNormal">@color/border_strong</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>
</resources>
