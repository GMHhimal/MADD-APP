<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="2dp" android:color="#59FFFFFF" />
        </shape>
    </item>
    <item android:top="18dp" android:bottom="18dp" android:left="18dp" android:right="18dp">
        <shape android:shape="oval">
            <solid android:color="#2EFFFFFF" />
            <stroke android:width="2dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
    <item android:top="40dp" android:bottom="40dp" android:left="40dp" android:right="40dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#66A9D0F2"
                android:endColor="#66B4A7E6" />
        </shape>
    </item>
</layer-list>
